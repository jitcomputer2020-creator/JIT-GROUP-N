{
  "entities": {
    "ProfileStats": {
      "title": "ProfileStats",
      "description": "User social and gaming activity metrics.",
      "type": "object",
      "properties": {
        "friendsCount": { "type": "integer", "description": "Number of friends." },
        "followersCount": { "type": "integer", "description": "Number of followers." },
        "followingCount": { "type": "integer", "description": "Number of accounts followed." },
        "postsCount": { "type": "integer", "description": "Total posts published." },
        "reelsCount": { "type": "integer", "description": "Total reels published." },
        "gamesPlayed": { "type": "integer", "description": "Total multiplayer games played." },
        "gamesWon": { "type": "integer", "description": "Total multiplayer games won." },
        "rewardPoints": { "type": "integer", "description": "Virtual reward points balance." },
        "streakDays": { "type": "integer", "description": "Consecutive active login streak days." }
      },
      "required": [
        "friendsCount",
        "followersCount",
        "followingCount",
        "postsCount",
        "reelsCount",
        "gamesPlayed",
        "gamesWon",
        "rewardPoints",
        "streakDays"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered JIT GROUP user profile persisted across browsers and devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Permanent unique user ID."
        },
        "contactNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30,
          "description": "User contact number as entered."
        },
        "phoneKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 15,
          "pattern": "^[0-9]{7,15}$",
          "description": "Normalized digit key for cross-browser phone lookup."
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "Public searchable handle without @ prefix."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name."
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "User campus location or address."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short profile biography."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Profile avatar URL or asset path."
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Profile cover photo URL."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp when account was created."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp of most recent login."
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "Standard lastLogin ISO timestamp alias."
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp used for 180-day inactivity expiration."
        },
        "isContactNumberPublic": {
          "type": "boolean",
          "description": "Whether contact number is visible to others."
        },
        "isAddressPublic": {
          "type": "boolean",
          "description": "Whether address is visible to others."
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "deleted"],
          "description": "Account moderation status."
        },
        "suspendedReason": {
          "type": "string",
          "maxLength": 300,
          "description": "Administrative reason if suspended."
        },
        "suspendedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp when moderation action occurred."
        },
        "lastDailyClaimAt": {
          "type": "integer",
          "description": "Unix epoch milliseconds of the most recent daily +50 Pts reward claim."
        },
        "stats": {
          "type": "object",
          "$ref": "#/entities/ProfileStats",
          "description": "User activity and reward statistics."
        }
      },
      "required": [
        "id",
        "contactNumber",
        "phoneKey",
        "fullName",
        "address",
        "joinedAt",
        "lastLoginAt",
        "lastLogin",
        "lastActiveAt",
        "stats"
      ]
    },
    "PhoneIndex": {
      "title": "PhoneIndex",
      "description": "Lookup index mapping normalized phone digits to profile ID without exposing PII.",
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target document ID in profiles collection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial registration."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest login for 180-day auto-cleanup."
        }
      },
      "required": ["profileId", "createdAt", "lastLoginAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII gaming scoreboard entry for global rankings.",
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference to profile ID."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Public player display name."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Player avatar URL."
        },
        "rewardPoints": {
          "type": "integer",
          "description": "Total virtual JIT points."
        },
        "gamesPlayed": {
          "type": "integer",
          "description": "Total games played."
        },
        "gamesWon": {
          "type": "integer",
          "description": "Total games won."
        },
        "streakDays": {
          "type": "integer",
          "description": "Daily activity streak."
        },
        "lastGameId": {
          "type": "string",
          "maxLength": 32,
          "description": "Most recent game played."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "profileId",
        "fullName",
        "rewardPoints",
        "gamesPlayed",
        "gamesWon",
        "streakDays",
        "updatedAt"
      ]
    },
    "MatchRecord": {
      "title": "MatchRecord",
      "description": "Immutable game match or reward spin record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique match record ID."
        },
        "profileId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Player profile ID."
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Player display name."
        },
        "gameId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "description": "Game identifier."
        },
        "gameName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "Human-readable game name."
        },
        "mode": {
          "type": "string",
          "enum": ["ai", "friend", "random", "solo"],
          "description": "Play mode."
        },
        "outcome": {
          "type": "string",
          "enum": ["win", "loss", "draw", "spin"],
          "description": "Match outcome."
        },
        "pointsEarned": {
          "type": "integer",
          "description": "Virtual points earned in this match."
        },
        "scoreSummary": {
          "type": "string",
          "maxLength": 180,
          "description": "Short match result summary."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp string."
        },
        "createdAtTs": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of match completion."
        }
      },
      "required": [
        "id",
        "profileId",
        "playerName",
        "gameId",
        "gameName",
        "mode",
        "outcome",
        "pointsEarned",
        "scoreSummary",
        "createdAt",
        "createdAtTs"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authorized administrator registry document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Verified administrator email address."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "UserDirectoryEntry": {
      "title": "UserDirectoryEntry",
      "description": "Non-PII searchable directory entry for app-wide peer discovery.",
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fullNameLower": { "type": "string", "minLength": 1, "maxLength": 120 },
        "username": { "type": "string", "minLength": 2, "maxLength": 64 },
        "usernameLower": { "type": "string", "minLength": 2, "maxLength": 64 },
        "avatarUrl": { "type": "string", "maxLength": 400000 },
        "bio": { "type": "string", "maxLength": 500 },
        "address": { "type": "string", "maxLength": 300 },
        "phoneLast4": { "type": "string", "maxLength": 4 },
        "rewardPoints": { "type": "integer" },
        "gamesWon": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "profileId",
        "fullName",
        "fullNameLower",
        "username",
        "usernameLower",
        "rewardPoints",
        "gamesWon",
        "updatedAt"
      ]
    },
    "GameRoom": {
      "title": "GameRoom",
      "description": "Real-time multiplayer room synced across devices via Firestore.",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "roomId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gameId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "gameType": { "type": "string", "minLength": 2, "maxLength": 32, "description": "Canonical game type identifier matching gameId." },
        "hostId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "player1": { "type": "string", "maxLength": 64, "description": "First joined host player ID." },
        "player1Id": { "type": "string", "maxLength": 64, "description": "Host player UID." },
        "player1AuthUid": { "type": "string", "maxLength": 64, "description": "Firebase Auth UID bound to player1 seat." },
        "player1Name": { "type": "string", "maxLength": 120, "description": "Host player display name." },
        "player2": { "type": "string", "maxLength": 64, "description": "Second joined player ID (null or empty string when waiting)." },
        "player2Id": { "type": "string", "maxLength": 64, "description": "Joining player UID (null or empty string when waiting)." },
        "player2AuthUid": { "type": "string", "maxLength": 64, "description": "Firebase Auth UID bound to player2 seat." },
        "player2Name": { "type": "string", "maxLength": 120, "description": "Joining player display name." },
        "status": { "type": "string", "enum": ["waiting", "active", "in_game", "finished"] },
        "maxPlayers": { "type": "integer" },
        "playerCount": { "type": "integer" },
        "isPublicMatch": { "type": "boolean" },
        "isOpenGroup": { "type": "boolean" },
        "activeSeatLimit": { "type": "integer" },
        "playersJson": { "type": "string", "maxLength": 100000 },
        "waitingPlayersJson": { "type": "string", "maxLength": 100000 },
        "reactionsJson": { "type": "string", "maxLength": 15000 },
        "mutedVoiceIdsJson": { "type": "string", "maxLength": 10000 },
        "mutedChatIdsJson": { "type": "string", "maxLength": 10000 },
        "gameStateJson": { "type": "string", "maxLength": 100000 },
        "boardState": { "type": "object", "description": "Structured Firestore-safe snapshot of the current game board." },
        "gameState": { "type": "object", "description": "Structured Firestore-safe alias of boardState." },
        "diceRoll": { "type": "integer", "description": "Latest dice roll value (null when unused)." },
        "lastMove": { "type": "object", "description": "Metadata about the most recent committed move." },
        "messagesJson": { "type": "string", "maxLength": 100000 },
        "moveAction": { "type": "string", "maxLength": 40 },
        "currentTurn": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": [
        "roomId",
        "gameType",
        "hostId",
        "player1Id",
        "status",
        "maxPlayers",
        "playerCount",
        "isPublicMatch",
        "playersJson",
        "gameStateJson",
        "messagesJson",
        "currentTurn",
        "createdAt",
        "lastUpdated"
      ]
    },
    "MatchmakingQueueEntry": {
      "title": "MatchmakingQueueEntry",
      "description": "Real-time queue ticket for instant player-to-player random matchmaking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "playerId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "playerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "playerAvatar": { "type": "string", "maxLength": 400000 },
        "gameId": { "type": "string", "enum": ["ludo", "tictactoe", "quiz", "chess", "snake_ladder", "carrom", "truth_dare"] },
        "status": { "type": "string", "enum": ["waiting", "matched"] },
        "matchedRoomCode": { "type": "string", "maxLength": 64 },
        "matchedWithId": { "type": "string", "maxLength": 64 },
        "joinedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "playerId", "playerName", "gameId", "status", "joinedAtMs", "createdAt", "updatedAt"]
    },
    "VoicePeer": {
      "title": "VoicePeer",
      "description": "Active player voice presence state inside a multiplayer game room.",
      "type": "object",
      "properties": {
        "peerId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "avatar": { "type": "string", "maxLength": 400000 },
        "micEnabled": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["peerId", "name", "micEnabled", "joinedAt", "updatedAt"]
    },
    "VoiceSignal": {
      "title": "VoiceSignal",
      "description": "WebRTC SDP offer/answer or ICE candidate signal document between room peers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "signalType": { "type": "string", "enum": ["offer", "answer", "candidate", "hangup"] },
        "sdp": { "type": "string", "maxLength": 20000 },
        "candidate": { "type": "string", "maxLength": 2000 },
        "sdpMid": { "type": "string", "maxLength": 64 },
        "sdpMLineIndex": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromId", "toId", "signalType", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Real-time peer-to-peer friend request document.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUserId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUserName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fromUserAvatar": { "type": "string", "maxLength": 400000 },
        "toUserId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "toUserName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "toUserAvatar": { "type": "string", "maxLength": 400000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fromUserId", "fromUserName", "toUserId", "toUserName", "status", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Real-time notification entry delivered to a recipient user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUserId": { "type": "string", "maxLength": 64 },
        "fromUserName": { "type": "string", "maxLength": 120 },
        "fromUserAvatar": { "type": "string", "maxLength": 400000 },
        "type": {
          "type": "string",
          "enum": ["friend_request", "friend_accept", "like", "comment", "message", "call", "game_invite", "tournament", "reward", "achievement"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 400 },
        "isRead": { "type": "boolean" },
        "createdAtIso": { "type": "string", "maxLength": 40 },
        "createdAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "title", "message", "isRead", "createdAtIso", "createdAtMs", "createdAt", "updatedAt"]
    },
    "DirectConversation": {
      "title": "DirectConversation",
      "description": "Direct message or group conversation metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "avatarUrl": { "type": "string", "maxLength": 400000 },
        "participantIds": { "type": "array", "description": "Participant profile IDs." },
        "participantsJson": { "type": "string", "maxLength": 30000 },
        "lastMessageText": { "type": "string", "maxLength": 500 },
        "lastMessageSenderId": { "type": "string", "maxLength": 64 },
        "lastMessageAt": { "type": "string", "maxLength": 40 },
        "updatedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "name", "participantIds", "participantsJson", "lastMessageText", "lastMessageSenderId", "lastMessageAt", "updatedAtMs", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message inside a direct or group conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "minLength": 8, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiverId": { "type": "string", "maxLength": 64 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "senderAvatar": { "type": "string", "maxLength": 400000 },
        "content": { "type": "string", "maxLength": 4000 },
        "type": { "type": "string", "enum": ["text", "image", "video", "file", "sticker"] },
        "stickerId": { "type": "string", "maxLength": 64 },
        "stickerData": { "type": "string", "maxLength": 8000 },
        "mediaUrl": { "type": "string", "maxLength": 400000 },
        "mediaType": { "type": "string", "enum": ["image", "video", "file"] },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "createdAt": { "type": "integer", "description": "Numeric Unix epoch timestamp in milliseconds." },
        "createdAtLabel": { "type": "string", "maxLength": 40, "description": "Formatted local time label." },
        "createdAtMs": { "type": "integer" },
        "createdAtTs": { "type": "string", "format": "date-time" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderId", "senderName", "content", "status", "createdAt", "createdAtMs", "createdAtTs"]
    },
    "UnifiedChat": {
      "title": "UnifiedChat",
      "description": "Canonical 1-on-1 DM or group chat room keyed by sorted participant IDs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "avatarUrl": { "type": "string", "maxLength": 400000 },
        "participants": { "type": "array", "description": "Sorted participant IDs." },
        "participantIds": { "type": "array", "description": "Participant IDs alias." },
        "participantsJson": { "type": "string", "maxLength": 30000 },
        "typingUsers": { "type": "object", "description": "Map of active userId -> epoch ms typing timestamp." },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastMessageText": { "type": "string", "maxLength": 500 },
        "lastMessageSenderId": { "type": "string", "maxLength": 64 },
        "lastMessageAt": { "type": "string", "maxLength": 40 },
        "updatedAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "participants", "lastMessage", "updatedAt"]
    },
    "UnifiedChatMessage": {
      "title": "UnifiedChatMessage",
      "description": "Message stored inside chats/{chatId}/messages with authoritative server timestamp.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "chatId": { "type": "string", "minLength": 4, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "minLength": 4, "maxLength": 140, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiverId": { "type": "string", "maxLength": 64 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "senderAvatar": { "type": "string", "maxLength": 400000 },
        "content": { "type": "string", "maxLength": 4000 },
        "type": { "type": "string", "enum": ["text", "image", "video", "file", "sticker"] },
        "stickerId": { "type": "string", "maxLength": 64 },
        "stickerData": { "type": "string", "maxLength": 8000 },
        "mediaUrl": { "type": "string", "maxLength": 400000 },
        "mediaType": { "type": "string", "enum": ["image", "video", "file"] },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "readBy": { "type": "array", "description": "List of user IDs who have read this message." },
        "readAt": { "type": "string", "format": "date-time", "description": "Authoritative Firestore server timestamp when read." },
        "timestamp": { "type": "string", "format": "date-time", "description": "Authoritative Firestore serverTimestamp()." },
        "clientCreatedAt": { "type": "integer", "description": "Client fallback timestamp while serverTimestamp is pending." }
      },
      "required": ["id", "chatId", "senderId", "senderName", "content", "status", "timestamp", "clientCreatedAt"]
    },
    "ReelItem": {
      "title": "ReelItem",
      "description": "Short video reel with generated thumbnail and 40-day auto-expiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "creatorAvatar": { "type": "string", "maxLength": 400000 },
        "videoUrl": { "type": "string", "maxLength": 750000 },
        "thumbnailUrl": { "type": "string", "maxLength": 180000 },
        "caption": { "type": "string", "maxLength": 1000 },
        "musicTitle": { "type": "string", "maxLength": 120 },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "viewsCount": { "type": "integer" },
        "likedBy": { "type": "array" },
        "commentsJson": { "type": "string", "maxLength": 100000 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "createdAtMs": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "createdAtTs": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorId", "creatorName", "videoUrl", "caption", "likesCount", "commentsCount", "sharesCount", "viewsCount", "likedBy", "createdAt", "createdAtMs", "expiresAt", "createdAtTs", "updatedAt"]
    },
    "FeedPost": {
      "title": "FeedPost",
      "description": "Social feed post with optional video thumbnail and 40-day expiry for videos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "authorAvatar": { "type": "string", "maxLength": 400000 },
        "authorHandle": { "type": "string", "maxLength": 80 },
        "content": { "type": "string", "maxLength": 5000 },
        "mediaUrls": { "type": "array" },
        "mediaType": { "type": "string", "enum": ["image", "video", "none"] },
        "thumbnailUrl": { "type": "string", "maxLength": 180000 },
        "category": { "type": "string", "enum": ["all", "friends", "following", "popular"] },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "likedBy": { "type": "array" },
        "commentsJson": { "type": "string", "maxLength": 100000 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "createdAtMs": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "createdAtTs": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "content", "mediaType", "category", "likesCount", "commentsCount", "sharesCount", "likedBy", "createdAt", "createdAtMs", "createdAtTs", "updatedAt"]
    },
    "GlobalAnnouncement": {
      "title": "GlobalAnnouncement",
      "description": "Site-wide admin broadcast notice with optional photo or video attachment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["info", "important", "event"] },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mediaUrl": { "type": "string", "maxLength": 750000 },
        "mediaType": { "type": "string", "enum": ["image", "video", "none"] },
        "thumbnailUrl": { "type": "string", "maxLength": 180000 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "createdAtMs": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "createdAtTs": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "message", "priority", "authorName", "createdAt", "createdAtMs", "createdAtTs"]
    },
    "VideoMedia": {
      "title": "VideoMedia",
      "description": "Metadata manifest for cross-device chunked cloud videos stored in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "creatorId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mimeType": { "type": "string", "minLength": 6, "maxLength": 64 },
        "totalChunks": { "type": "integer" },
        "totalBytes": { "type": "integer" },
        "createdAtMs": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorId", "mimeType", "totalChunks", "totalBytes", "createdAtMs", "expiresAt", "createdAt"]
    },
    "VideoMediaChunk": {
      "title": "VideoMediaChunk",
      "description": "Sequential base64 chunk segment belonging to a VideoMedia manifest.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mediaId": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "index": { "type": "integer" },
        "data": { "type": "string", "maxLength": 700000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mediaId", "index", "data", "createdAt"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Persistent user profile documents accessible across browsers and devices."
    },
    "/phone_index/{phoneKey}": {
      "schema": { "$ref": "#/entities/PhoneIndex" },
      "description": "Normalized contact-number lookup index mapping phoneKey to profileId."
    },
    "/leaderboard/{profileId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public non-PII gaming leaderboard rankings sorted by reward points."
    },
    "/match_history/{matchId}": {
      "schema": { "$ref": "#/entities/MatchRecord" },
      "description": "Immutable match results and daily spin reward ledger."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Authorized administrator accounts permitted to list user profiles."
    },
    "/user_directory/{profileId}": {
      "schema": { "$ref": "#/entities/UserDirectoryEntry" },
      "description": "Non-PII searchable directory for app-wide friend search."
    },
    "/gameRooms/{roomCode}": {
      "schema": { "$ref": "#/entities/GameRoom" },
      "description": "Real-time 4-digit code multiplayer rooms synced via Firestore."
    },
    "/matchmakingQueue/{ticketId}": {
      "schema": { "$ref": "#/entities/MatchmakingQueueEntry" },
      "description": "Real-time random matchmaking queue entries paired transactionally into shared game rooms."
    },
    "/gameRooms/{roomCode}/voice_peers/{peerId}": {
      "schema": { "$ref": "#/entities/VoicePeer" },
      "description": "Live voice chat participant presence inside an active game room."
    },
    "/gameRooms/{roomCode}/voice_signals/{signalId}": {
      "schema": { "$ref": "#/entities/VoiceSignal" },
      "description": "WebRTC peer-to-peer audio signaling channel for an active game room."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Real-time friend request status tracking across users."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Real-time notifications delivered to target users."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/DirectConversation" },
      "description": "Direct and group messaging threads."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a direct or group conversation."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/UnifiedChat" },
      "description": "Canonical 1-on-1 DM and group chat documents."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/UnifiedChatMessage" },
      "description": "Real-time messages inside a canonical chat ordered by server timestamp."
    },
    "/reels/{reelId}": {
      "schema": { "$ref": "#/entities/ReelItem" },
      "description": "Uploaded video reels with 40-day automatic expiry."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/FeedPost" },
      "description": "Public feed posts including video posts with 40-day automatic expiry."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/GlobalAnnouncement" },
      "description": "Site-wide admin announcements with optional image or video banners."
    },
    "/video_media/{mediaId}": {
      "schema": { "$ref": "#/entities/VideoMedia" },
      "description": "Cross-device cloud video manifest documents."
    },
    "/video_media/{mediaId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/VideoMediaChunk" },
      "description": "Sequential base64 chunks for cross-device video playback."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Connectivity health-check document read during client startup."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Compatibility alias collection for user profile documents."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/GameRoom" },
      "description": "Compatibility alias collection for multiplayer game rooms."
    },
    "/matchmaking/{ticketId}": {
      "schema": { "$ref": "#/entities/MatchmakingQueueEntry" },
      "description": "Compatibility alias collection for matchmaking queue tickets."
    }
  }
}
