{
  "entities": {
    "ProfileStats": {
      "title": "ProfileStats",
      "description": "User social and gaming activity metrics.",
      "type": "object",
      "properties": {
        "friendsCount": { "type": "integer", "description": "Number of friends." },
        "followersCount": { "type": "integer", "description": "Number of followers." },
        "followingCount": { "type": "integer", "description": "Number of accounts followed." },
        "postsCount": { "type": "integer", "description": "Total posts published." },
        "reelsCount": { "type": "integer", "description": "Total reels published." },
        "gamesPlayed": { "type": "integer", "description": "Total multiplayer games played." },
        "gamesWon": { "type": "integer", "description": "Total multiplayer games won." },
        "rewardPoints": { "type": "integer", "description": "Virtual reward points balance." },
        "streakDays": { "type": "integer", "description": "Consecutive active login streak days." }
      },
      "required": [
        "friendsCount",
        "followersCount",
        "followingCount",
        "postsCount",
        "reelsCount",
        "gamesPlayed",
        "gamesWon",
        "rewardPoints",
        "streakDays"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered JIT GROUP user profile persisted across browsers and devices.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Permanent unique user ID."
        },
        "contactNumber": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30,
          "description": "User contact number as entered."
        },
        "phoneKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 15,
          "pattern": "^[0-9]{7,15}$",
          "description": "Normalized digit key for cross-browser phone lookup."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name."
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "User campus location or address."
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short profile biography."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Profile avatar URL or asset path."
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Profile cover photo URL."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp when account was created."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp of most recent login."
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "Standard lastLogin ISO timestamp alias."
        },
        "lastActiveAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp used for 180-day inactivity expiration."
        },
        "isContactNumberPublic": {
          "type": "boolean",
          "description": "Whether contact number is visible to others."
        },
        "isAddressPublic": {
          "type": "boolean",
          "description": "Whether address is visible to others."
        },
        "stats": {
          "type": "object",
          "$ref": "#/entities/ProfileStats",
          "description": "User activity and reward statistics."
        }
      },
      "required": [
        "id",
        "contactNumber",
        "phoneKey",
        "fullName",
        "address",
        "joinedAt",
        "lastLoginAt",
        "lastLogin",
        "lastActiveAt",
        "stats"
      ]
    },
    "PhoneIndex": {
      "title": "PhoneIndex",
      "description": "Lookup index mapping normalized phone digits to profile ID without exposing PII.",
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target document ID in profiles collection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial registration."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest login for 180-day auto-cleanup."
        }
      },
      "required": ["profileId", "createdAt", "lastLoginAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII gaming scoreboard entry for global rankings.",
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reference to profile ID."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Public player display name."
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 400000,
          "description": "Player avatar URL."
        },
        "rewardPoints": {
          "type": "integer",
          "description": "Total virtual JIT points."
        },
        "gamesPlayed": {
          "type": "integer",
          "description": "Total games played."
        },
        "gamesWon": {
          "type": "integer",
          "description": "Total games won."
        },
        "streakDays": {
          "type": "integer",
          "description": "Daily activity streak."
        },
        "lastGameId": {
          "type": "string",
          "maxLength": 32,
          "description": "Most recent game played."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "profileId",
        "fullName",
        "rewardPoints",
        "gamesPlayed",
        "gamesWon",
        "streakDays",
        "updatedAt"
      ]
    },
    "MatchRecord": {
      "title": "MatchRecord",
      "description": "Immutable game match or reward spin record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique match record ID."
        },
        "profileId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Player profile ID."
        },
        "playerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Player display name."
        },
        "gameId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "description": "Game identifier."
        },
        "gameName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "Human-readable game name."
        },
        "mode": {
          "type": "string",
          "enum": ["ai", "friend", "random", "solo"],
          "description": "Play mode."
        },
        "outcome": {
          "type": "string",
          "enum": ["win", "loss", "draw", "spin"],
          "description": "Match outcome."
        },
        "pointsEarned": {
          "type": "integer",
          "description": "Virtual points earned in this match."
        },
        "scoreSummary": {
          "type": "string",
          "maxLength": 180,
          "description": "Short match result summary."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40,
          "description": "ISO timestamp string."
        },
        "createdAtTs": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of match completion."
        }
      },
      "required": [
        "id",
        "profileId",
        "playerName",
        "gameId",
        "gameName",
        "mode",
        "outcome",
        "pointsEarned",
        "scoreSummary",
        "createdAt",
        "createdAtTs"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authorized administrator registry document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Verified administrator email address."
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "grantedAt"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Persistent user profile documents accessible across browsers and devices."
    },
    "/phone_index/{phoneKey}": {
      "schema": { "$ref": "#/entities/PhoneIndex" },
      "description": "Normalized contact-number lookup index mapping phoneKey to profileId."
    },
    "/leaderboard/{profileId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public non-PII gaming leaderboard rankings sorted by reward points."
    },
    "/match_history/{matchId}": {
      "schema": { "$ref": "#/entities/MatchRecord" },
      "description": "Immutable match results and daily spin reward ledger."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Authorized administrator accounts permitted to list user profiles."
    }
  }
}
