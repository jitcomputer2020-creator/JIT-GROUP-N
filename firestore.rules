rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all fallback for any unmapped collection path
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Structural Validation Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidDocId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 160 &&
        id.matches('^[a-zA-Z0-9_\\-\\.@:]+$');
    }

    function isBoundedQuery() {
      return request.query.limit == null || request.query.limit <= 1000;
    }

    function isValidPayload() {
      return incoming() is map &&
        incoming().keys().size() >= 1 &&
        incoming().keys().size() <= 60;
    }

    function isValidDocWrite(id) {
      return isValidDocId(id) && isValidPayload();
    }

    function isValidExistingDoc(id) {
      return isValidDocId(id) && existing() is map;
    }

    // 3. Startup Connectivity Check Document (/test/connection)
    match /test/{docId} {
      allow get: if isValidDocId(docId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(docId);
      allow delete: if isValidExistingDoc(docId);
    }

    // 4. Profiles & Users Collections (supports Firebase Auth, phone login, and guest sessions)
    match /profiles/{profileId} {
      allow get: if isValidDocId(profileId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(profileId);
      allow delete: if isValidExistingDoc(profileId);
    }

    match /users/{userId} {
      allow get: if isValidDocId(userId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(userId);
      allow delete: if isValidExistingDoc(userId);
    }

    // 5. Phone Lookup Index
    match /phone_index/{phoneKey} {
      allow get: if isValidDocId(phoneKey);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(phoneKey);
      allow delete: if isValidExistingDoc(phoneKey);
    }

    // 6. Public Campus Gaming Leaderboard
    match /leaderboard/{profileId} {
      allow get: if isValidDocId(profileId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(profileId);
      allow delete: if isValidExistingDoc(profileId);
    }

    // 7. Match History & Reward Ledger
    match /match_history/{matchId} {
      allow get: if isValidDocId(matchId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(matchId);
      allow delete: if isValidExistingDoc(matchId);
    }

    // 8. Authorized Administrator Registry (read-only lookup for signed-in admins)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidDocId(adminId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 9. Public Non-PII User Search Directory
    match /user_directory/{profileId} {
      allow get: if isValidDocId(profileId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(profileId);
      allow delete: if isValidExistingDoc(profileId);
    }

    // 10. Real-Time Multiplayer Game Rooms (/gameRooms and /rooms alias)
    match /gameRooms/{roomCode} {
      allow get: if isValidDocId(roomCode);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(roomCode);
      allow delete: if isValidExistingDoc(roomCode);

      match /voice_peers/{peerId} {
        allow get: if isValidDocId(roomCode) && isValidDocId(peerId);
        allow list: if isValidDocId(roomCode) && isBoundedQuery();
        allow create, update: if isValidDocId(roomCode) && isValidDocWrite(peerId);
        allow delete: if isValidDocId(roomCode) && isValidExistingDoc(peerId);
      }

      match /voice_signals/{signalId} {
        allow get: if isValidDocId(roomCode) && isValidDocId(signalId);
        allow list: if isValidDocId(roomCode) && isBoundedQuery();
        allow create, update: if isValidDocId(roomCode) && isValidDocWrite(signalId);
        allow delete: if isValidDocId(roomCode) && isValidExistingDoc(signalId);
      }
    }

    match /rooms/{roomId} {
      allow get: if isValidDocId(roomId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(roomId);
      allow delete: if isValidExistingDoc(roomId);
    }

    // 11. Real-Time Random Matchmaking Queue (/matchmakingQueue and /matchmaking alias)
    match /matchmakingQueue/{ticketId} {
      allow get: if isValidDocId(ticketId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(ticketId);
      allow delete: if isValidExistingDoc(ticketId);
    }

    match /matchmaking/{ticketId} {
      allow get: if isValidDocId(ticketId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(ticketId);
      allow delete: if isValidExistingDoc(ticketId);
    }

    // 12. Real-Time Friend Requests
    match /friendRequests/{requestId} {
      allow get: if isValidDocId(requestId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(requestId);
      allow delete: if isValidExistingDoc(requestId);
    }

    // 13. Real-Time User Notifications
    match /notifications/{notificationId} {
      allow get: if isValidDocId(notificationId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(notificationId);
      allow delete: if isValidExistingDoc(notificationId);
    }

    // 14. Personal Direct Messages & Group Conversations
    match /conversations/{conversationId} {
      allow get: if isValidDocId(conversationId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(conversationId);
      allow delete: if isValidExistingDoc(conversationId);

      match /messages/{messageId} {
        allow get: if isValidDocId(conversationId) && isValidDocId(messageId);
        allow list: if isValidDocId(conversationId) && isBoundedQuery();
        allow create, update: if isValidDocId(conversationId) && isValidDocWrite(messageId);
        allow delete: if isValidDocId(conversationId) && isValidExistingDoc(messageId);
      }
    }

    // 14b. Canonical Unified Chats & Server-Timestamped Messages
    match /chats/{chatId} {
      allow get: if isValidDocId(chatId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(chatId);
      allow delete: if isValidExistingDoc(chatId);

      match /messages/{messageId} {
        allow get: if isValidDocId(chatId) && isValidDocId(messageId);
        allow list: if isValidDocId(chatId) && isBoundedQuery();
        allow create, update: if isValidDocId(chatId) && isValidDocWrite(messageId);
        allow delete: if isValidDocId(chatId) && isValidExistingDoc(messageId);
      }
    }

    // CollectionGroup query support for DM inspection across senderId / receiverId
    match /{path=**}/messages/{messageId} {
      allow list: if isBoundedQuery();
    }

    // 15. Video Reels
    match /reels/{reelId} {
      allow get: if isValidDocId(reelId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(reelId);
      allow delete: if isValidExistingDoc(reelId);
    }

    // 16. Public Feed Posts
    match /posts/{postId} {
      allow get: if isValidDocId(postId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(postId);
      allow delete: if isValidExistingDoc(postId);
    }

    // 17. Site-Wide Global Announcements
    match /announcements/{announcementId} {
      allow get: if isValidDocId(announcementId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(announcementId);
      allow delete: if isValidExistingDoc(announcementId);
    }

    // 18. Cross-Device Chunked Cloud Video Storage
    match /video_media/{mediaId} {
      allow get: if isValidDocId(mediaId);
      allow list: if isBoundedQuery();
      allow create, update: if isValidDocWrite(mediaId);
      allow delete: if isValidExistingDoc(mediaId);

      match /chunks/{chunkId} {
        allow get: if isValidDocId(mediaId) && isValidDocId(chunkId);
        allow list: if isValidDocId(mediaId) && isBoundedQuery();
        allow create, update: if isValidDocId(mediaId) && isValidDocWrite(chunkId);
        allow delete: if isValidDocId(mediaId) && isValidExistingDoc(chunkId);
      }
    }
  }
}
